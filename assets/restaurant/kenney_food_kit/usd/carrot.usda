    def Material "Material"
    {
        token outputs:surface.connect = </Asset/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Asset/Material/Color.outputs:rgb>
            float inputs:roughness = 0.65
            token outputs:surface
        }

        def Shader "Color"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../source/Textures/colormap.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Asset/Material/UV.outputs:result>
            color3f outputs:rgb
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }
}

